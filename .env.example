# Copy this file to .env and update values for your local PostgreSQL installation.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=postgresql
DB_NAME=collabdocs
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional local fallback (set DB_ENGINE=sqlite)
# DB_ENGINE=sqlite
